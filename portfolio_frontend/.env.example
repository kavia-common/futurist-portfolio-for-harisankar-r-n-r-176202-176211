# Optional direct API endpoint to receive contact form submissions (expects JSON: {name,email,message})
REACT_APP_CONTACT_ENDPOINT=

# EmailJS fallback (used if CONTACT_ENDPOINT is not set)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Optional analytics identifier; if unset, analytics is disabled
REACT_APP_ANALYTICS_ID=
